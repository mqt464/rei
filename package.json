{
  "name": "rei",
  "version": "1.0.0",
  "description": "A minimal and opinionated Chromium browser built ontop of electron.",
  "main": "./out/main/index.js",
  "author": "mqt464",
  "homepage": "https://mqt464.github.io/rei/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mqt464/rei.git"
  },
  "scripts": {
    "check:fullscreen": "node scripts/check-website-permissions.cjs && node scripts/check-fullscreen.cjs",
    "check:default-browser": "node scripts/check-default-browser.cjs",
    "prototype:commands": "node scripts/prototype-commands.cjs",
    "check:commands": "node scripts/check-playing-media.cjs && node scripts/check-commands.cjs",
    "check:updates": "node scripts/check-updates.cjs && node scripts/check-update-settings.cjs",
    "check:text-morph": "node scripts/check-text-morph.cjs && node scripts/check-text-morph-dom.cjs",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.65.0",
    "electron-chrome-context-menu": "^1.1.0",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
